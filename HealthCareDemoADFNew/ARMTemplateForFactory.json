								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/Healthgrp-Repo/health-adfrepo/Landing to bronze",
							"baseParameters": {
								"source_system": {
									"value": "@{activity('Read table details').output.firstRow.source_system}",
