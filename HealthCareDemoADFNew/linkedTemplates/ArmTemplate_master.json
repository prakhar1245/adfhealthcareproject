{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "HealthCareDemoADFNew"
		},
		"ls_PostgreSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-shy-lake-b3h8x9ek-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"ls_PostgreSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_PostgreSql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"ls_adlssource_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://healthcarepojectadf.dfs.core.windows.net/"
		},
		"postgres_akv_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://postgres-akv.vault.azure.net/"
		},
		"AzureKeyVaultsql_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://sqlazuredb.vault.azure.net/"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "healthcare-adfdb.database.windows.net"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-healthcare"
		},
		"LS_AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "prakhar"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "HealthCareDemoADFNew_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adlssource_properties_typeProperties_url": {
						"value": "[parameters('ls_adlssource_properties_typeProperties_url')]"
					},
					"postgres_akv_properties_typeProperties_baseUrl": {
						"value": "[parameters('postgres_akv_properties_typeProperties_baseUrl')]"
					},
					"AzureKeyVaultsql_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVaultsql_properties_typeProperties_baseUrl')]"
					},
					"ls_PostgreSql_properties_typeProperties_server": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_server')]"
					},
					"ls_PostgreSql_properties_typeProperties_database": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_database')]"
					},
					"ls_PostgreSql_properties_typeProperties_username": {
						"value": "[parameters('ls_PostgreSql_properties_typeProperties_username')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"LS_AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}