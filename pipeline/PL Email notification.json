{
	"name": "PL Email notification",
	"properties": {
		"activities": [
			{
				"name": "Read all status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT  * FROM [ctrl].[audit_log] where adf_run_id ='@{pipeline().parameters.adf_run_id}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "prepare body email header",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body header",
					"value": "Ingestion is completed and below is the status"
				}
			},
			{
				"name": "prepare body email footer",
				"description": "",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "header",
					"value": "Please reach out to abc@gmail.com if required"
				}
			},
			{
				"name": "prepare body email subject",
				"description": "Please reach out to abc@gmail.com if required",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "check all failed count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "@{pipeline().globalParameters.enviornment} |\n @{if(greater(activity('check all failed count').output.firstRow.rcount,0),'FAILED' ,'SUCCESS' )}  | HealthCare )",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check all failed count",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT  count(*) as rcount FROM [ctrl].[audit_log] where adf_run_id ='@{pipeline().parameters.adf_run_id}'\nand status !='SUCCESS'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Prepare logic apps body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare body email subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare body email footer",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare body email header",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Read all status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logic apss body",
					"value": {
						"value": "{\n  \n  \"subject\": \"@{variables('email_subject')}\",\n  \"email_receipients\": \"@{pipeline().globalParameters.email_global}\",\n  \"body header\": \"@{variables('body header')} \",\n   \"body footer\": \"@{variables('header')}\",\n  \"status table\":@{activity('Read all status').output.value}\n}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"body header": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"logic apss body": {
				"type": "String"
			},
			"header": {
				"type": "String"
			}
		},
		"annotations": []
	}
}